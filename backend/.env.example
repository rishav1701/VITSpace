# Database Selection: sqlite (Local, recommended) or oracle (Remote)
DB_TYPE=sqlite
SQLITE_DB_PATH=vitspace.db

# Oracle Connection (Only needed if DB_TYPE=oracle)
ORACLE_USER=system
ORACLE_PASSWORD=your_password_here
ORACLE_DSN=localhost:1521/XEPDB1

# JWT Settings
AUTH_SECRET=change-this-to-a-random-64-char-string
AUTH_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# Admin Setup
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
